APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# SQLite は 1 ファイルへ読み書きが集中すると "database is locked"（HY000 / code 5）になる。
# SESSION_DRIVER=database・CACHE_STORE=database（レートリミットのカウンタ）・応募行の書き込みが同じ DB に集中するため、
# SQLite 既定値（busy_timeout 0ms / journal_mode delete）では別リクエストの書き込みと衝突した瞬間に 500 になる。
# 既定は WAL（読み取りと書き込みを並行化）+ ロック最大 5000ms 待機 + synchronous=NORMAL。
# ※ 共有ホスティングで DB が NFS 等のネットワーク FS 上の場合は WAL を使わない（DB_SQLITE_JOURNAL_MODE=DELETE に戻す）。
DB_SQLITE_JOURNAL_MODE=WAL
DB_SQLITE_BUSY_TIMEOUT=5000
DB_SQLITE_SYNCHRONOUS=NORMAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ARstampRally202611 抽選応募のメールアドレス確認（requirements.md FR-61 / design.md §5.7）
# 本番（Xserver）は MAIL_MAILER=smtp + MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD /
# MAIL_ENCRYPTION に SMTP 情報を入れ、MAIL_FROM_ADDRESS は送信元アドレス（subscription@seiei.online）へ。
# MAIL_MAILER=log の開発環境では確認コードが storage/logs/laravel.log にしか出ないため、
# 確認フローを試さないなら AR202611_EMAIL_VERIFICATION=false で無効化する（従来どおり 1 ステップで応募可）。
AR202611_EMAIL_VERIFICATION=true
AR202611_EMAIL_CODE_TTL=900
AR202611_EMAIL_MAX_ATTEMPTS=5
AR202611_EMAIL_RESEND_INTERVAL=30
# 1 端末（fingerprint）あたり 1 時間の確認コード送信上限（FR-61・変更用コード FR-63 も同じ上限）。
# アドレスを打ち間違えて「直して送り直す」再試行を吸収できる数（従来 3 回だと正常な再試行が 429 で止まった）。
# 総当たりは AR202611_EMAIL_MAX_ATTEMPTS（1 コードあたりの入力試行上限）で止まるため、送信回数の上限は緩めてよい。
AR202611_EMAIL_CODE_LIMIT_PER_HOUR=6
# AR202611_EMAIL_DNS_CHECK=true にすると参加者のドメインを checkdnsrr() で照会して、
# 解決できないドメインは 422 invalid_email で弾く（共有ホスティングでは遅い/誤検知リスクがあるため既定 false）。
# ※ Laravel には dns バリデーションルールは無い。ルール文字列へ |dns を連結すると 500 になる（design.md §5.7）。
AR202611_EMAIL_DNS_CHECK=false

# 応募済みメールアドレスの変更を受理する最終日時（requirements.md FR-63 / design.md §5.8・JST）。
# 抽選を 11 月末頃に行うため、既定は 2026-11-30 23:59:59。経過後は 422 change_deadline_passed で
# スタンプ帳の「登録したメールアドレスを変更する」ボタンも消える。抽選日を変える場合だけ調整する。
AR202611_EMAIL_CHANGE_DEADLINE="2026-11-30 23:59:59"

# テストデータリセットの世代番号（requirements.md FR-65 / design.md §5.11）。
# サーバー側の marker_scans / stamp202611_voucher_applications を消した日と同じ日に 1 増やすと、
# 次回のページ読み込みで全端末の 202611 系 localStorage / IndexedDB / SW キャッシュが消える。
# 端末に保存された世代と不一致のときだけ発火する（冪等）。他キャンペーン（202610 以前）には影響しない。
# 変更後は必ず php artisan config:clear && php artisan view:clear && php artisan cache:clear を行う
# （config:cache 済みだと古い世代がキャッシュされたまま残り、リセットが効かない）。
AR202611_RESET_EPOCH=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
